APP_NAME="Senselab Core API"
APP_ENV=testing
APP_KEY=base64:VK9GvSar2QujzBKJmJy4qpYrX9OVzs60TLbo5MiKbOQ=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Base de datos para testing (en memoria)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=api_db_test
DB_USERNAME=senselab_user
DB_PASSWORD=senselab_password

# Cache y sesión en array (sin Redis para tests)
SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Cache en memoria (array driver)
CACHE_STORE=array
CACHE_PREFIX=test

# Redis deshabilitado en tests
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_FROM_ADDRESS=test@senselab.com
MAIL_FROM_NAME="Senselab Test"

# Deshabilitar broadcasting en tests
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# Sentry deshabilitado en tests
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Configuración de pruebas
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
