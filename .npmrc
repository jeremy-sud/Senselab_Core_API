# =============================================================================
# Configuración de pnpm para Senselab Core API
# =============================================================================
# SEGURIDAD: Este proyecto usa pnpm en lugar de npm por razones de seguridad
# - Mejor manejo de dependencias (no duplicados, estructura plana)
# - Content-addressable storage
# - Verificación de integridad de paquetes
# - Protección contra ataques de supply chain
# =============================================================================

# Usar pnpm como gestor de paquetes
engine-strict=true

# Seguridad: Verificar firmas de paquetes
strict-peer-dependencies=true

# Evitar scripts post-install maliciosos por defecto
ignore-scripts=false

# Usar lockfile estricto
frozen-lockfile=true

# Audit automático
audit=true

# Deshabilitar telemetría
enable-pre-post-scripts=true

# No permitir instalación con npm o yarn
# Esto asegura que solo pnpm se use
only-allow-pnpm=true

# Verificar integridad
prefer-frozen-lockfile=true
verify-store-integrity=true

# Configuración de registro - usar registro oficial de npm
registry=https://registry.npmjs.org/

# Guardar dependencias exactas (sin ^)
save-exact=true

# Deshabilitar instalación de dependencias opcionales sospechosas
optional=false
