# Environment Configuration for Docker
# Copiar a .env: cp .env.docker .env

APP_NAME="Senselab Core API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (Docker)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=api_db
DB_USERNAME=senselab_user
DB_PASSWORD=senselab_password

# Database Root (para inicialización)
DB_ROOT_PASSWORD=root_password

# Redis (Docker)
BROADCAST_CONNECTION=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (Mailhog para desarrollo)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@senselab.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Puertos (personalizables)
NGINX_PORT=8000
NGINX_SSL_PORT=8443
MYSQL_PORT=3306
REDIS_PORT=6379
PHPMYADMIN_PORT=8080
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# ============================================================
# Sentry Error Tracking (opcional en desarrollo)
# ============================================================
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false
SENTRY_BREADCRUMBS_SQL=true
SENTRY_BREADCRUMBS_SQL_BINDINGS=false

# ============================================================
# CORS
# ============================================================
CORS_PATHS=api/*,sanctum/csrf-cookie
CORS_ALLOWED_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ALLOWED_HEADERS=Content-Type,X-Requested-With,Authorization,X-Trace-ID,Accept,X-Tenant-ID
CORS_EXPOSED_HEADERS=X-Trace-ID,X-Request-ID
CORS_MAX_AGE=86400
CORS_SUPPORTS_CREDENTIALS=false

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_AUTH=10
RATE_LIMIT_API=60
RATE_LIMIT_REPORTS=5
RATE_LIMIT_HACIENDA=20

# ============================================================
# Hacienda Costa Rica (Sandbox para desarrollo)
# ============================================================
HACIENDA_ENV=sandbox
HACIENDA_CLIENT_ID=
HACIENDA_CLIENT_SECRET=
HACIENDA_CERT_PATH=
HACIENDA_CERT_PASSWORD=
HACIENDA_API_URL_SANDBOX=https://api-sandbox.comprobanteselectronicos.go.cr
HACIENDA_API_URL_PROD=https://api.comprobanteselectronicos.go.cr
HACIENDA_IDP_URL=https://idp-sandbox.comprobanteselectronicos.go.cr
HACIENDA_CALLBACK_URL=http://localhost:8000/api/fe/callback
HACIENDA_CACHE_ENABLED=true
HACIENDA_CACHE_TOKEN_TTL=3600
HACIENDA_CACHE_RESPONSE_TTL=300

# ============================================================
# Inteligencia Artificial (opcional)
# ============================================================
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_VISION_MODEL=gemini-1.5-flash
GEMINI_LOG_CHANNEL=stack
GEMINI_LOG_ENABLED=false
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# Swagger
L5_SWAGGER_USE_ABSOLUTE_PATH=true
L5_FORMAT_TO_USE_FOR_DOCS=json
