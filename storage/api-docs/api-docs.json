{
    "openapi": "3.0.0",
    "info": {
        "title": "Ursol CAST API - ERP System",
        "description": "API completa de ERP para empresas costarricenses. Sistema integral de gestión empresarial con soporte para contabilidad, facturación electrónica, inventario, compras, ventas, recursos humanos y más.",
        "contact": {
            "name": "Sistemas Ursol",
            "email": "soporte@ursol.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Servidor de Desarrollo Local"
        },
        {
            "url": "https://api.ursol.com",
            "description": "Servidor de Producción"
        }
    ],
    "paths": {
        "/api/login": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Iniciar sesión",
                "description": "Autentica un usuario con email y contraseña. Devuelve un token Bearer para usar en las siguientes peticiones.",
                "operationId": "login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin@ursol.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "admin123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login exitoso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "properties": {
                                                "usuario": {
                                                    "$ref": "#/components/schemas/Usuario"
                                                },
                                                "token": {
                                                    "type": "string",
                                                    "example": "1|abcdef123456..."
                                                },
                                                "permisos": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string",
                                                        "example": "productos.ver"
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Login exitoso"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Credenciales incorrectas",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Las credenciales son incorrectas."
                                        },
                                        "errors": {
                                            "properties": {
                                                "email": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string",
                                                        "example": "Las credenciales son incorrectas."
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Cerrar sesión",
                "description": "Revoca el token actual del usuario autenticado",
                "operationId": "logout",
                "responses": {
                    "200": {
                        "description": "Logout exitoso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Logout exitoso"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Unauthenticated."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/user": {
            "get": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Obtener usuario autenticado",
                "description": "Devuelve la información del usuario autenticado incluyendo sus roles, permisos, empresa y cargo",
                "operationId": "getCurrentUser",
                "responses": {
                    "200": {
                        "description": "Usuario obtenido exitosamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "properties": {
                                                "usuario": {
                                                    "$ref": "#/components/schemas/Usuario"
                                                },
                                                "permisos": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string",
                                                        "example": "productos.ver"
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Unauthenticated."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/productos": {
            "get": {
                "tags": [
                    "Productos"
                ],
                "summary": "Listar productos",
                "description": "Obtiene el listado de productos con filtros, búsqueda y paginación",
                "operationId": "getProductos",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Búsqueda por nombre, código, código de barras o descripción",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "laptop"
                        }
                    },
                    {
                        "name": "empresa_id",
                        "in": "query",
                        "description": "Filtrar por empresa (multi-tenancy)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    },
                    {
                        "name": "categoria_id",
                        "in": "query",
                        "description": "Filtrar por categoría",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    },
                    {
                        "name": "tipo",
                        "in": "query",
                        "description": "Filtrar por tipo de producto",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "PRODUCTO",
                                "SERVICIO",
                                "COMBO"
                            ],
                            "example": "PRODUCTO"
                        }
                    },
                    {
                        "name": "activos",
                        "in": "query",
                        "description": "Filtrar solo productos activos",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "example": true
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Cantidad de resultados por página",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 15,
                            "example": 15
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Listado de productos",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Producto"
                                            }
                                        },
                                        "links": {
                                            "properties": {
                                                "first": {
                                                    "type": "string"
                                                },
                                                "last": {
                                                    "type": "string"
                                                },
                                                "prev": {
                                                    "type": "string",
                                                    "nullable": true
                                                },
                                                "next": {
                                                    "type": "string",
                                                    "nullable": true
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "meta": {
                                            "properties": {
                                                "current_page": {
                                                    "type": "integer"
                                                },
                                                "total": {
                                                    "type": "integer"
                                                },
                                                "per_page": {
                                                    "type": "integer"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "500": {
                        "description": "Error del servidor"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Productos"
                ],
                "summary": "Crear producto",
                "description": "Crea un nuevo producto en el sistema",
                "operationId": "createProducto",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "nombre",
                                    "codigo",
                                    "empresa_id",
                                    "tipo"
                                ],
                                "properties": {
                                    "nombre": {
                                        "type": "string",
                                        "example": "Laptop Dell Inspiron"
                                    },
                                    "codigo": {
                                        "type": "string",
                                        "example": "PROD-001"
                                    },
                                    "codigo_barras": {
                                        "type": "string",
                                        "example": "1234567890123",
                                        "nullable": true
                                    },
                                    "descripcion": {
                                        "type": "string",
                                        "example": "Laptop 15 pulgadas, 8GB RAM",
                                        "nullable": true
                                    },
                                    "empresa_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "categoria_id": {
                                        "type": "integer",
                                        "example": 1,
                                        "nullable": true
                                    },
                                    "tipo": {
                                        "type": "string",
                                        "enum": [
                                            "PRODUCTO",
                                            "SERVICIO",
                                            "COMBO"
                                        ],
                                        "example": "PRODUCTO"
                                    },
                                    "precio_compra": {
                                        "type": "number",
                                        "format": "decimal",
                                        "example": 450000,
                                        "nullable": true
                                    },
                                    "precio_venta": {
                                        "type": "number",
                                        "format": "decimal",
                                        "example": 650000
                                    },
                                    "unidad_medida_id": {
                                        "type": "integer",
                                        "example": 1,
                                        "nullable": true
                                    },
                                    "marca_id": {
                                        "type": "integer",
                                        "example": 1,
                                        "nullable": true
                                    },
                                    "impuesto_id": {
                                        "type": "integer",
                                        "example": 1,
                                        "nullable": true
                                    },
                                    "activo": {
                                        "type": "boolean",
                                        "example": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Producto creado exitosamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Producto"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Producto creado exitosamente"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "422": {
                        "description": "Datos de validación incorrectos"
                    },
                    "500": {
                        "description": "Error del servidor"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/productos/{id}": {
            "get": {
                "tags": [
                    "Productos"
                ],
                "summary": "Obtener producto",
                "description": "Obtiene los detalles de un producto específico",
                "operationId": "getProducto",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID del producto",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Producto encontrado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Producto"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "404": {
                        "description": "Producto no encontrado"
                    },
                    "500": {
                        "description": "Error del servidor"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Productos"
                ],
                "summary": "Actualizar producto",
                "description": "Actualiza los datos de un producto existente",
                "operationId": "updateProducto",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID del producto",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "nombre": {
                                        "type": "string",
                                        "example": "Laptop Dell Inspiron Actualizada"
                                    },
                                    "descripcion": {
                                        "type": "string",
                                        "example": "Laptop 15 pulgadas, 16GB RAM",
                                        "nullable": true
                                    },
                                    "precio_compra": {
                                        "type": "number",
                                        "format": "decimal",
                                        "example": 500000,
                                        "nullable": true
                                    },
                                    "precio_venta": {
                                        "type": "number",
                                        "format": "decimal",
                                        "example": 700000
                                    },
                                    "activo": {
                                        "type": "boolean",
                                        "example": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Producto actualizado exitosamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Producto"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Producto actualizado exitosamente"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "404": {
                        "description": "Producto no encontrado"
                    },
                    "422": {
                        "description": "Datos de validación incorrectos"
                    },
                    "500": {
                        "description": "Error del servidor"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Productos"
                ],
                "summary": "Eliminar producto",
                "description": "Elimina (soft delete) un producto marcándolo como inactivo y eliminado",
                "operationId": "deleteProducto",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID del producto",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Producto eliminado exitosamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Producto eliminado exitosamente"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "404": {
                        "description": "Producto no encontrado"
                    },
                    "500": {
                        "description": "Error del servidor"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "Cargo": {
                "title": "Cargo",
                "description": "Cargo o puesto de trabajo",
                "required": [
                    "id",
                    "nombre",
                    "empresa_id"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "nombre": {
                        "type": "string",
                        "example": "Gerente General"
                    },
                    "descripcion": {
                        "type": "string",
                        "example": "Responsable de la administración general",
                        "nullable": true
                    },
                    "empresa_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "activo": {
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            },
            "CategoriaProducto": {
                "title": "Categoría de Producto",
                "description": "Categoría para clasificar productos",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "nombre": {
                        "type": "string",
                        "example": "Electrónicos"
                    },
                    "descripcion": {
                        "type": "string",
                        "example": "Categoría de productos electrónicos",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "Empresa": {
                "title": "Empresa",
                "description": "Empresa del sistema (tenant)",
                "required": [
                    "id",
                    "nombre",
                    "identificacion"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "nombre": {
                        "type": "string",
                        "example": "Sistemas Ursol S.A."
                    },
                    "nombre_comercial": {
                        "type": "string",
                        "example": "Ursol",
                        "nullable": true
                    },
                    "identificacion": {
                        "type": "string",
                        "example": "3-101-123456"
                    },
                    "tipo_identificacion": {
                        "type": "string",
                        "enum": [
                            "CEDULA_FISICA",
                            "CEDULA_JURIDICA",
                            "DIMEX",
                            "NITE"
                        ],
                        "example": "CEDULA_JURIDICA"
                    },
                    "telefono": {
                        "type": "string",
                        "example": "2222-3333",
                        "nullable": true
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "info@ursol.com",
                        "nullable": true
                    },
                    "activo": {
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            },
            "Impuesto": {
                "title": "Impuesto",
                "description": "Impuesto aplicable a productos",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "nombre": {
                        "type": "string",
                        "example": "IVA 13%"
                    },
                    "porcentaje": {
                        "type": "number",
                        "format": "decimal",
                        "example": 13
                    }
                },
                "type": "object"
            },
            "Marca": {
                "title": "Marca",
                "description": "Marca de productos",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "nombre": {
                        "type": "string",
                        "example": "Dell"
                    }
                },
                "type": "object"
            },
            "Permiso": {
                "title": "Permiso",
                "description": "Permiso del sistema",
                "required": [
                    "id",
                    "nombre",
                    "slug",
                    "modulo"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "nombre": {
                        "type": "string",
                        "example": "Ver productos"
                    },
                    "slug": {
                        "type": "string",
                        "example": "productos.ver"
                    },
                    "modulo": {
                        "type": "string",
                        "example": "productos"
                    },
                    "descripcion": {
                        "type": "string",
                        "example": "Permite visualizar el listado de productos",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "Producto": {
                "title": "Producto",
                "description": "Producto del inventario",
                "required": [
                    "id",
                    "nombre",
                    "codigo",
                    "empresa_id",
                    "tipo"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "nombre": {
                        "type": "string",
                        "example": "Laptop Dell Inspiron"
                    },
                    "codigo": {
                        "type": "string",
                        "example": "PROD-001"
                    },
                    "codigo_barras": {
                        "type": "string",
                        "example": "1234567890123",
                        "nullable": true
                    },
                    "descripcion": {
                        "type": "string",
                        "example": "Laptop 15 pulgadas, 8GB RAM",
                        "nullable": true
                    },
                    "empresa_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "categoria_id": {
                        "type": "integer",
                        "example": 1,
                        "nullable": true
                    },
                    "tipo": {
                        "type": "string",
                        "enum": [
                            "PRODUCTO",
                            "SERVICIO",
                            "COMBO"
                        ],
                        "example": "PRODUCTO"
                    },
                    "precio_compra": {
                        "type": "number",
                        "format": "decimal",
                        "example": 450000,
                        "nullable": true
                    },
                    "precio_venta": {
                        "type": "number",
                        "format": "decimal",
                        "example": 650000
                    },
                    "unidad_medida_id": {
                        "type": "integer",
                        "example": 1,
                        "nullable": true
                    },
                    "marca_id": {
                        "type": "integer",
                        "example": 1,
                        "nullable": true
                    },
                    "impuesto_id": {
                        "type": "integer",
                        "example": 1,
                        "nullable": true
                    },
                    "activo": {
                        "type": "boolean",
                        "example": true
                    },
                    "eliminado": {
                        "type": "boolean",
                        "example": false
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-01-01T00:00:00.000000Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-01-01T00:00:00.000000Z"
                    },
                    "empresa": {
                        "$ref": "#/components/schemas/Empresa"
                    },
                    "categoria": {
                        "oneOf": [
                            {
