{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for XDebug (Docker)",
            "type": "php",
            "port": 9003,
            "pathMapping": {
                "/app": "${workspaceRoot}"
            },
            "xdebugSettings": {
                "max_data": 65535,
                "show_hidden": 1,
                "max_children": 100
            }
        },
        {
            "name": "Listen for XDebug (Local)",
            "type": "php",
            "port": 9003,
            "pathMapping": {
                "/app": "${workspaceRoot}"
            }
        }
    ]
}
