GEMINI_API_KEY=AIzaSyBM9rUx56gUotGN8V9sRK5uhWyXTr1ELA0

# CORS Configuration (FASE 1.2 - Security Headers)
# Rutas donde se permite CORS (separaradas por comas)
CORS_PATHS=api/*,sanctum/csrf-cookie

# Métodos HTTP permitidos (separadas por comas)
CORS_ALLOWED_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS

# Orígenes permitidos (separadas por comas)
# Desarrollo: http://localhost:3000 (Vite/React), http://localhost:5173 (Vue), etc.
# Producción: Configurar solo los dominios autorizados
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Headers personalizados permitidos (separadas por comas)
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin,Access-Control-Request-Method,Access-Control-Request-Headers,X-API-Key,X-Tenant-ID

# Headers que el navegador puede leer en la respuesta (separadas por comas)
CORS_EXPOSED_HEADERS=X-Total-Count,X-Page-Count,X-Current-Page,X-Per-Page,X-Request-ID,X-Response-Time

# Tiempo de caché para preflight requests (en segundos)
# 0 = sin caché (desarrollo), 86400 = 24 horas (producción)
CORS_MAX_AGE=0

# Permitir cookies y headers de autenticación en requests CORS
CORS_SUPPORTS_CREDENTIALS=true

# Patrón de subdominio para multi-tenancy (dejar vacío si no se usa)
CORS_SUBDOMAIN_PATTERN=

# Sentry Error Tracking (FASE 1.4)
# DSN from https://sentry.io (create a new project)
SENTRY_LARAVEL_DSN=
SENTRY_LARAVEL_ENABLED=false

# Sentry environment (production, staging, development)
SENTRY_ENVIRONMENT=local

# Performance monitoring sample rate (0.0-1.0)
# 0.1 = 10% of transactions (balance: insight vs. volume)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Profiling sample rate (0.0-1.0)
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Release tracking (useful for correlation)
SENTRY_RELEASE=${APP_VERSION}