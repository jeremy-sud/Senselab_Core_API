<?xml version="1.0"?>
<!--
  PHP Mess Detector — Ruleset para Senselab Core API
  Usado por: .github/workflows/code-analysis.yml (job phpmd)

  Referencia: https://phpmd.org/rules/index.html
-->
<ruleset name="Senselab Core API"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">

    <description>Reglas de PHPMD para el proyecto Senselab Core API</description>

    <!-- ================================================================
         Código innecesariamente complejo
    ================================================================ -->
    <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
        <properties>
            <property name="reportLevel" value="15"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/NPathComplexity">
        <properties>
            <property name="minimum" value="200"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
        <properties>
            <property name="minimum" value="100"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveClassLength">
        <properties>
            <property name="minimum" value="500"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveParameterList">
        <properties>
            <property name="minimum" value="10"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/TooManyPublicMethods">
        <properties>
            <property name="maxmethods" value="20"/>
        </properties>
    </rule>

    <!-- ================================================================
         Diseño
    ================================================================ -->
    <rule ref="rulesets/design.xml">
        <!-- Excluir: Laravel usa eval en algunos helpers de Blade -->
        <exclude name="EvalExpression"/>
        <!-- Excluir: Los Service Providers usan exit() intencionalmente en artisan -->
        <exclude name="ExitExpression"/>
    </rule>

    <!-- ================================================================
         Nombres claros
    ================================================================ -->
    <rule ref="rulesets/naming.xml">
        <!-- Excluir: propiedades cortas son comunes en DTOs/Value Objects -->
        <exclude name="ShortVariable"/>
        <!-- Excluir: nombres largos son descriptivos en Laravel -->
        <exclude name="LongVariable"/>
    </rule>

    <!-- ================================================================
         Código no utilizado
    ================================================================ -->
    <rule ref="rulesets/unusedcode.xml"/>

    <!-- ================================================================
         Controversial (solo algunas reglas)
    ================================================================ -->
    <rule ref="rulesets/controversial.xml/Superglobals"/>

</ruleset>
