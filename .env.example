APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TENANT_BASE_DOMAIN=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sentry Error Tracking
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false
SENTRY_BREADCRUMBS_SQL=true
SENTRY_BREADCRUMBS_SQL_BINDINGS=false
SENTRY_TRACING_ENABLED=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=api_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.scisenselab.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ================================================================================
# SEEDERS - DEFAULT PASSWORDS
# ================================================================================
# ADVERTENCIA: Cambiar estas contraseñas en producción
# Las contraseñas de seeders son solo para desarrollo local

# Contraseña para Fundador 1
FOUNDER1_PASSWORD=Senselab2024!

# Contraseña para Fundador 2 (Jeremy Arias Solano)
FOUNDER2_PASSWORD=Senselab2024!

# Contraseña para usuario administrador del sistema
ADMIN_SEEDER_PASSWORD=admin123

# ================================================================================
# HACIENDA COSTA RICA - FACTURACIÓN ELECTRÓNICA v4.4
# ================================================================================
# Configuración para integración con el API de Comprobantes Electrónicos
# del Ministerio de Hacienda de Costa Rica.
#
# Versión actual: 4.4 (DGT-R-000-2024)
# Documentación: https://www.hacienda.go.cr/docs/ComprobantesElectronicosAPI.html
# Contacto: facturati@hacienda.go.cr
# ================================================================================

# Versión del esquema XML
HACIENDA_VERSION_ESQUEMA=4.4

# Proveedor del sistema de facturación (OBLIGATORIO v4.4)
# Cédula o identificación del proveedor del sistema
HACIENDA_PROVEEDOR_SISTEMAS=

# Ambiente de ejecución: sandbox (ATV) o production
HACIENDA_ENVIRONMENT=sandbox

# ---- FIRMA XAdES-EPES v4.4 ----
# URL y hash de la política de firma según DGT-R-000-2024
HACIENDA_XADES_POLICY_URL=https://atv.hacienda.go.cr/ATV/ComprobanteElectronico/docs/esquemas/2016/v4.4/ResolucionComprobantesElectronicosDGT-R-000-2024.pdf
HACIENDA_XADES_POLICY_HASH=NmI5Njk1ZThkNzI0MmIzMGJmZDAyNDc4YjUwNzkzODM2NTBiOWUxNTBkMmI2YjgzYzZjM2I5NTZlNDQ4OWQzMQ==

# ---- CREDENCIALES OAUTH 2.0 ----
# Flujo: Resource Owner Password Credentials (grant_type=password)
# Las credenciales se generan en la Oficina Virtual (OVi) > Tico Factura
# Sandbox: client_id=api-stag | Producción: client_id=api-prod
# client_secret y scope NO son requeridos por Hacienda
HACIENDA_OAUTH_CLIENT_ID=api-stag
HACIENDA_OAUTH_CLIENT_SECRET=
HACIENDA_OAUTH_SCOPE=
HACIENDA_OAUTH_USERNAME=
HACIENDA_OAUTH_PASSWORD=

# ---- URLS DE LA API ----
# Sandbox (Staging)
HACIENDA_OAUTH_URL_SANDBOX=https://idp.comprobanteselectronicos.go.cr/auth/realms/rut-stag/protocol/openid-connect/token
HACIENDA_LOGOUT_URL_SANDBOX=https://idp.comprobanteselectronicos.go.cr/auth/realms/rut-stag/protocol/openid-connect/logout
HACIENDA_API_URL_SANDBOX=https://api-sandbox.comprobanteselectronicos.go.cr/recepcion/v1

# Producción
HACIENDA_OAUTH_URL_PROD=https://idp.comprobanteselectronicos.go.cr/auth/realms/rut/protocol/openid-connect/token
HACIENDA_LOGOUT_URL_PROD=https://idp.comprobanteselectronicos.go.cr/auth/realms/rut/protocol/openid-connect/logout
HACIENDA_API_URL_PROD=https://api.comprobanteselectronicos.go.cr/recepcion/v1

# ---- CERTIFICADO DIGITAL ----
# Certificado .p12 para firma digital (XAdES-EPES)
# Colocar en: storage/app/certificates/certificate.p12
HACIENDA_CERT_PATH=
HACIENDA_CERT_PASSWORD=
HACIENDA_CERT_VALIDATE_EXPIRY=true

# ---- CONFIGURACIÓN HTTP ----
HACIENDA_HTTP_TIMEOUT=30
HACIENDA_HTTP_CONNECT_TIMEOUT=10
HACIENDA_HTTP_RETRY_TIMES=3
HACIENDA_HTTP_RETRY_DELAY=1000

# ---- RATE LIMITING ----
# Límites API Hacienda: 10 req/seg sostenido, 20 req/seg burst
HACIENDA_RATE_LIMIT_ENABLED=true
HACIENDA_RATE_LIMIT_MAX_PER_SEC=8
HACIENDA_RATE_LIMIT_MAX_PER_MIN=480

# ---- CACHE ----
HACIENDA_CACHE_ENABLED=true
HACIENDA_CACHE_TOKEN_TTL=3600
HACIENDA_CACHE_RESPONSE_TTL=300

# ---- CALLBACK URL ----
# URL donde Hacienda enviará las respuestas de aceptación/rechazo
HACIENDA_CALLBACK_URL="${APP_URL}/api/hacienda/callback"

# ---- LOGGING ----
HACIENDA_LOG_ENABLED=true
HACIENDA_LOG_CHANNEL=daily
HACIENDA_LOG_LEVEL=info
HACIENDA_LOG_SAVE_XML=true

# ---- E2E SANDBOX TESTING (FASE 19.6) ----
# Credenciales de pruebas generadas en OVi > Tico Factura
# SOLO para tests E2E contra sandbox real de Hacienda
HACIENDA_SANDBOX_USERNAME=
HACIENDA_SANDBOX_PASSWORD=
HACIENDA_SANDBOX_CERT_PIN=
HACIENDA_SANDBOX_CERT_PATH=storage/app/certificates/sandbox/010647095827.p12

# ================================================================================
# GOOGLE GEMINI - INTELIGENCIA ARTIFICIAL (GRATUITO - RECOMENDADO)
# ================================================================================
# Configuración para integración con Google Gemini AI
# ¡API COMPLETAMENTE GRATUITA!
#
# Obtener API Key: https://aistudio.google.com/
# Documentación: https://ai.google.dev/gemini-api/docs
#
# Límites tier gratuito:
# - gemini-2.0-flash: 15 requests/min, 1500 requests/día
# - gemini-1.5-flash: 15 requests/min (con Vision para OCR)
# ================================================================================

# ---- CREDENCIALES ----
# API Key de Gemini (obtener GRATIS en aistudio.google.com)
GEMINI_API_KEY=

# ---- MODELOS (Opcionales - tienen defaults) ----
# Modelo principal para chat (rápido y gratis)
GEMINI_CHAT_MODEL=gemini-2.0-flash

# Modelo con Vision para OCR de facturas
GEMINI_VISION_MODEL=gemini-1.5-flash

# ---- LOGGING ----
GEMINI_LOG_ENABLED=true
GEMINI_LOG_CHANNEL=daily

# ================================================================================
# OPENAI - ALTERNATIVA DE PAGO (OPCIONAL)
# ================================================================================
# Solo necesario si prefieres usar OpenAI en lugar de Gemini
# El sistema usa Gemini por defecto si está configurado
#
# Documentación: https://platform.openai.com/docs
# API Keys: https://platform.openai.com/api-keys
# ================================================================================

# ---- CREDENCIALES ----
# API Key de OpenAI (solo si no usas Gemini)
OPENAI_API_KEY=

# Organization ID (opcional)
OPENAI_ORGANIZATION=

# ================================================================================
# GOOGLE OAUTH CONFIGURATION (SSO / SOCIALITE)
# ================================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.scisenselab.com/api/auth/google/callback

# ================================================================================
# STRIPE SUBSCRIPTION & BILLING INTEGRATION
# ================================================================================
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=


